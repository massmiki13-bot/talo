{
  "name": "WorksitePayment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "worksite_id": {
      "type": "string",
      "title": "Lavoro"
    },
    "worksite_nome": {
      "type": "string",
      "title": "Nome Lavoro"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome Cliente"
    },
    "importo": {
      "type": "number",
      "title": "Importo"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "acconto",
        "saldo"
      ],
      "title": "Tipo",
      "default": "acconto"
    },
    "metodo": {
      "type": "string",
      "title": "Metodo di Pagamento"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "worksite_id",
    "importo",
    "data"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}