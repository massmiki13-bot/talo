{
  "name": "Contact",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "fornitore",
        "entrambi"
      ],
      "title": "Tipo"
    },
    "nome": {
      "type": "string",
      "title": "Ragione Sociale"
    },
    "nome_privato": {
      "type": "string",
      "title": "Nome"
    },
    "partita_iva": {
      "type": "string",
      "title": "Partita IVA"
    },
    "codice_fiscale": {
      "type": "string",
      "title": "Codice Fiscale"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Città"
    },
    "cap": {
      "type": "string",
      "title": "CAP"
    },
    "provincia": {
      "type": "string",
      "title": "Provincia"
    },
    "telefono": {
      "type": "string",
      "title": "Telefono"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "pec": {
      "type": "string",
      "title": "PEC"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "tipo_soggetto": {
      "type": "string",
      "enum": [
        "privato",
        "azienda",
        "ente"
      ],
      "title": "Tipo soggetto",
      "default": "azienda"
    },
    "cellulare": {
      "type": "string",
      "title": "Cellulare"
    },
    "sito_web": {
      "type": "string",
      "title": "Sito web"
    },
    "codice_sdi": {
      "type": "string",
      "title": "Codice destinatario SDI"
    },
    "iban": {
      "type": "string",
      "title": "IBAN"
    },
    "categorie": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Categorie"
    },
    "categoria_fornitore": {
      "type": "string",
      "title": "Categoria merceologica"
    },
    "referenti": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Referenti"
    },
    "indirizzi": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Sedi e indirizzi di cantiere"
    },
    "sconto_default": {
      "type": "number",
      "title": "Sconto abituale %"
    },
    "iva_default": {
      "type": "number",
      "title": "Aliquota IVA abituale %"
    },
    "pagamento_default": {
      "type": "string",
      "title": "Modalità di pagamento abituale"
    },
    "termini_pagamento_giorni": {
      "type": "number",
      "title": "Termini di pagamento (giorni)"
    },
    "archiviato": {
      "type": "boolean",
      "title": "Archiviato",
      "default": false
    }
  },
  "required": [
    "tipo"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
