{
  "name": "DocumentFolder",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "nome": {
      "type": "string",
      "title": "Nome Cartella"
    },
    "ordine": {
      "type": "number",
      "title": "Ordine",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "title": "Cartella superiore"
    },
    "colore": {
      "type": "string",
      "title": "Colore"
    },
    "descrizione": {
      "type": "string",
      "title": "Descrizione"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
