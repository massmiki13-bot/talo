{
  "name": "Branch",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome Sede"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Citt\u00e0"
    },
    "attivo": {
      "type": "boolean",
      "title": "Attiva",
      "default": true
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}