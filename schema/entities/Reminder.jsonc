{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "descrizione": {
      "type": "string",
      "title": "Descrizione"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "ora": {
      "type": "string",
      "title": "Ora"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "appuntamento",
        "chiamata",
        "scadenza_documento",
        "scadenza_contratto",
        "scadenza_fiscale",
        "incasso",
        "pagamento",
        "sollecito_preventivo",
        "formazione",
        "cantiere",
        "altro"
      ],
      "title": "Tipo"
    },
    "completato": {
      "type": "boolean",
      "title": "Completato",
      "default": false
    },
    "is_preavviso": {
      "type": "boolean",
      "title": "Preavviso",
      "default": false
    },
    "riferimento_id": {
      "type": "string",
      "title": "Riferimento ID"
    },
    "riferimento_tipo": {
      "type": "string",
      "title": "Riferimento Tipo"
    },
    "priorita": {
      "type": "string",
      "enum": [
        "alta",
        "normale",
        "bassa"
      ],
      "title": "Priorità",
      "default": "normale"
    },
    "ricorrenza": {
      "type": "string",
      "enum": [
        "nessuna",
        "settimanale",
        "mensile",
        "trimestrale",
        "annuale"
      ],
      "title": "Si ripete",
      "default": "nessuna"
    },
    "assegnato_a": {
      "type": "string",
      "title": "Assegnato a (utente)"
    },
    "assegnato_nome": {
      "type": "string",
      "title": "Assegnato a"
    },
    "luogo": {
      "type": "string",
      "title": "Luogo"
    },
    "completato_il": {
      "type": "string",
      "title": "Completato il"
    },
    "posticipato": {
      "type": "number",
      "title": "Volte posticipato",
      "default": 0
    },
    "principale_id": {
      "type": "string",
      "title": "Promemoria principale"
    },
    "anticipo_giorni": {
      "type": "number",
      "title": "Giorni di anticipo"
    }
  },
  "required": [
    "titolo",
    "data"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
