{
  "name": "Employee",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "cognome": {
      "type": "string",
      "title": "Cognome"
    },
    "codice_fiscale": {
      "type": "string",
      "title": "Codice Fiscale"
    },
    "data_nascita": {
      "type": "string",
      "format": "date",
      "title": "Data di Nascita"
    },
    "luogo_nascita": {
      "type": "string",
      "title": "Luogo di Nascita"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "telefono": {
      "type": "string",
      "title": "Telefono"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "ruolo": {
      "type": "string",
      "title": "Ruolo/Mansione"
    },
    "data_assunzione": {
      "type": "string",
      "format": "date",
      "title": "Data Assunzione"
    },
    "tipo_contratto": {
      "type": "string",
      "title": "Tipo Contratto"
    },
    "costo_orario": {
      "type": "number",
      "title": "Costo Orario (€)"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "branch_id": {
      "type": "string",
      "title": "Sede"
    },
    "branch_nome": {
      "type": "string",
      "title": "Nome Sede"
    },
    "foto_url": {
      "type": "string",
      "title": "Foto"
    },
    "matricola": {
      "type": "string",
      "title": "Matricola"
    },
    "cellulare": {
      "type": "string",
      "title": "Cellulare"
    },
    "nazionalita": {
      "type": "string",
      "title": "Nazionalità"
    },
    "permesso_soggiorno_scadenza": {
      "type": "string",
      "title": "Scadenza permesso di soggiorno"
    },
    "livello": {
      "type": "string",
      "title": "Livello"
    },
    "qualifica": {
      "type": "string",
      "title": "Qualifica"
    },
    "ccnl": {
      "type": "string",
      "title": "CCNL"
    },
    "data_fine_contratto": {
      "type": "string",
      "title": "Fine contratto"
    },
    "ore_settimanali": {
      "type": "number",
      "title": "Ore settimanali",
      "default": 40
    },
    "iban": {
      "type": "string",
      "title": "IBAN"
    },
    "patenti": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Patenti e abilitazioni"
    },
    "taglie": {
      "type": "object",
      "title": "Taglie DPI"
    },
    "contatto_emergenza": {
      "type": "object",
      "title": "Contatto di emergenza"
    },
    "dpi_consegnati": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "DPI consegnati"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "cessato"
      ],
      "title": "Stato",
      "default": "attivo"
    },
    "data_cessazione": {
      "type": "string",
      "title": "Data cessazione"
    }
  },
  "required": [
    "nome",
    "cognome"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
