{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Azienda"
    },
    "nome": {
      "type": "string",
      "title": "Nome Template"
    },
    "oggetto": {
      "type": "string",
      "title": "Oggetto"
    },
    "corpo": {
      "type": "string",
      "title": "Corpo Email"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "preventivo",
        "fattura",
        "generico"
      ],
      "title": "Tipo"
    }
  },
  "required": [
    "nome",
    "oggetto",
    "corpo"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}