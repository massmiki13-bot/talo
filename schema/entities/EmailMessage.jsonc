{
  "name": "EmailMessage",
  "type": "object",
  "properties": {
    "account_id": { "type": "string", "title": "Casella" },
    "account_email": { "type": "string", "title": "Indirizzo casella" },
    "direzione": { "type": "string", "enum": ["in", "out"], "title": "Direzione", "default": "out" },
    "stato": { "type": "string", "enum": ["bozza", "inviata", "errore", "ricevuta"], "title": "Stato", "default": "bozza" },
    "is_pec": { "type": "boolean", "title": "PEC", "default": false },
    "pec_tipo": { "type": "string", "title": "Tipo messaggio PEC" },
    "from_name": { "type": "string", "title": "Mittente (nome)" },
    "from_email": { "type": "string", "title": "Mittente" },
    "to": { "type": "array", "items": { "type": "string" }, "title": "Destinatari" },
    "cc": { "type": "array", "items": { "type": "string" }, "title": "Cc" },
    "bcc": { "type": "array", "items": { "type": "string" }, "title": "Ccn" },
    "subject": { "type": "string", "title": "Oggetto" },
    "html": { "type": "string", "title": "Testo HTML" },
    "text": { "type": "string", "title": "Testo" },
    "snippet": { "type": "string", "title": "Anteprima" },
    "data": { "type": "string", "title": "Data" },
    "message_id": { "type": "string", "title": "Message-ID" },
    "in_reply_to": { "type": "string", "title": "In risposta a" },
    "imap_uid": { "type": "number", "title": "UID IMAP" },
    "imap_uidvalidity": { "type": "string", "title": "UIDVALIDITY IMAP" },
    "allegati": { "type": "array", "title": "Allegati", "items": { "type": "object" } },
    "letto": { "type": "boolean", "title": "Letto", "default": true },
    "contact_id": { "type": "string", "title": "Cliente/Fornitore" },
    "worksite_id": { "type": "string", "title": "Lavoro" },
    "quote_id": { "type": "string", "title": "Preventivo" },
    "errore": { "type": "string", "title": "Errore invio" },
    "search_text": { "type": "string", "title": "Testo di ricerca" }
  },
  "required": ["direzione", "stato"]
}
