{
  "name": "EmailAccount",
  "type": "object",
  "properties": {
    "email_address": {
      "type": "string",
      "title": "Indirizzo Email"
    },
    "display_name": {
      "type": "string",
      "title": "Nome Mittente"
    },
    "provider": {
      "type": "string",
      "enum": [
        "gmail_oauth",
        "outlook_oauth",
        "smtp"
      ],
      "title": "Tipo Connessione",
      "default": "smtp"
    },
    "smtp_host": {
      "type": "string",
      "title": "Server SMTP"
    },
    "smtp_port": {
      "type": "number",
      "title": "Porta SMTP",
      "default": 587
    },
    "smtp_username": {
      "type": "string",
      "title": "Username SMTP"
    },
    "smtp_password": {
      "type": "string",
      "title": "Password per App"
    },
    "is_default": {
      "type": "boolean",
      "title": "Predefinito",
      "default": false
    },
    "active": {
      "type": "boolean",
      "title": "Attivo",
      "default": true
    },
    "is_pec": {
      "type": "boolean",
      "title": "Casella PEC",
      "default": false
    },
    "imap_host": {
      "type": "string",
      "title": "Server IMAP (posta in arrivo)"
    },
    "imap_port": {
      "type": "number",
      "title": "Porta IMAP",
      "default": 993
    },
    "ricezione_attiva": {
      "type": "boolean",
      "title": "Scarica posta in arrivo",
      "default": true
    },
    "firma_html": {
      "type": "string",
      "title": "Firma personalizzata"
    },
    "ultimo_uid": {
      "type": "number",
      "title": "Ultimo UID scaricato"
    },
    "uidvalidity": {
      "type": "string",
      "title": "UIDVALIDITY"
    },
    "ultima_sincronizzazione": {
      "type": "string",
      "title": "Ultima sincronizzazione"
    }
  },
  "required": [
    "email_address",
    "provider"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
